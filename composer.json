{
    "name": "atwx/friendlyplay-helper",
    "description": "Vereinfachte Schnittstelle, um aus Silverstripe mit friendlyplay (Leaderboards, Spieler, Signale) zu kommunizieren.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "friendlyplay",
        "leaderboard",
        "highscore",
        "atwx"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "silverstripe/framework": "^6.0",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\FriendlyPlay\\": "src/",
            "Atwx\\FriendlyPlay\\Tests\\": "tests/php/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
